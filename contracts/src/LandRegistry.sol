pragma solidity ^0.8.24;

import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";

contract LandRegistry is Ownable, ReentrancyGuard {
    using SafeERC20 for IERC20;
    enum LandStatus { Registered, Disputed, Frozen }
    enum DisputeStatus { Open, Upheld, Rejected }
    struct LandRecord { uint256 id; string plotId; bytes32 docHash; address owner; address registrar; string description; string geoCell; uint64 registeredAt; LandStatus status; uint32 openDisputes; }
    struct Dispute { uint256 id; uint256 landId; address claimant; bytes32 evidenceHash; string note; uint256 bond; uint64 raisedAt; DisputeStatus status; }
    struct Transfer { address from; address to; uint64 at; bytes32 newDocHash; }
    struct TransferRequest { address to; bytes32 newDocHash; bool pending; }
    IERC20 public immutable usdt; address public treasury; uint256 public disputeBond = 10e6; uint256 public nextLandId = 1; uint256 public nextDisputeId = 1;
    mapping(uint256 => LandRecord) public lands; mapping(bytes32 => uint256) public landByDocHash; mapping(bytes32 => uint256) public landByPlotKey; mapping(uint256 => Dispute[]) private disputesByLand; mapping(uint256 => Transfer[]) private historyOf; mapping(uint256 => TransferRequest) public pendingTransfer; mapping(address => bool) public isRegistrar;
    event RegistrarAdded(address indexed registrar); event RegistrarRemoved(address indexed registrar); event LandRegistered(uint256 indexed id, string plotId, bytes32 docHash, address indexed owner); event DisputeRaised(uint256 indexed landId, uint256 indexed disputeId, address indexed claimant); event DisputeResolved(uint256 indexed landId, uint256 indexed disputeId, bool upheld); event LandFrozen(uint256 indexed landId); event LandUnfrozen(uint256 indexed landId); event TransferRequested(uint256 indexed landId, address indexed to); event TransferApproved(uint256 indexed landId, address indexed from, address indexed to);
    modifier onlyRegistrar() { require(isRegistrar[msg.sender], "not registrar"); _; }
    constructor(address usdt_, address treasury_) Ownable(msg.sender) { require(usdt_ != address(0) && treasury_ != address(0), "zero address"); usdt = IERC20(usdt_); treasury = treasury_; }
    function addRegistrar(address account) external onlyOwner { require(account != address(0), "zero address"); isRegistrar[account] = true; emit RegistrarAdded(account); }
    function removeRegistrar(address account) external onlyOwner { isRegistrar[account] = false; emit RegistrarRemoved(account); }
    function setDisputeBond(uint256 amount) external onlyOwner { disputeBond = amount; }
    function setTreasury(address account) external onlyOwner { require(account != address(0), "zero address"); treasury = account; }
    function registerLand(string calldata plotId, bytes32 docHash, address owner_, string calldata description, string calldata geoCell) external onlyRegistrar returns (uint256 id) { require(bytes(plotId).length > 0 && bytes(plotId).length <= 120, "invalid plot"); require(bytes(description).length <= 200 && bytes(geoCell).length <= 120, "text too long"); require(docHash != bytes32(0) && owner_ != address(0) && owner_ != msg.sender, "invalid record"); bytes32 key = keccak256(bytes(plotId)); require(landByDocHash[docHash] == 0 && landByPlotKey[key] == 0, "duplicate record"); id = nextLandId++; lands[id] = LandRecord(id, plotId, docHash, owner_, msg.sender, description, geoCell, uint64(block.timestamp), LandStatus.Registered, 0); landByDocHash[docHash] = id; landByPlotKey[key] = id; historyOf[id].push(Transfer(address(0), owner_, uint64(block.timestamp), docHash)); emit LandRegistered(id, plotId, docHash, owner_); }
    function verify(bytes32 docHash) external view returns (bool found, uint256 landId, LandStatus status, address owner_, address registrar, uint64 registeredAt, uint32 openDisputes) { landId = landByDocHash[docHash]; if (landId == 0) return (false, 0, LandStatus.Registered, address(0), address(0), 0, 0); LandRecord storage l = lands[landId]; return (true, landId, l.status, l.owner, l.registrar, l.registeredAt, l.openDisputes); }
    function getByPlotId(string calldata plotId) external view returns (bool found, uint256 landId, LandStatus status, address owner_, address registrar, uint64 registeredAt, uint32 openDisputes) { landId = landByPlotKey[keccak256(bytes(plotId))]; if (landId == 0) return (false, 0, LandStatus.Registered, address(0), address(0), 0, 0); LandRecord storage l = lands[landId]; return (true, landId, l.status, l.owner, l.registrar, l.registeredAt, l.openDisputes); }
    function raiseDispute(uint256 landId, bytes32 evidenceHash, string calldata note) external nonReentrant { LandRecord storage l = lands[landId]; require(l.id != 0, "unknown land"); require(l.owner != msg.sender, "owner cannot dispute"); require(evidenceHash != bytes32(0) && bytes(note).length <= 200, "invalid evidence"); usdt.safeTransferFrom(msg.sender, address(this), disputeBond); uint256 id = nextDisputeId++; disputesByLand[landId].push(Dispute(id, landId, msg.sender, evidenceHash, note, disputeBond, uint64(block.timestamp), DisputeStatus.Open)); l.openDisputes++; l.status = LandStatus.Disputed; emit DisputeRaised(landId, id, msg.sender); }
    function resolveDispute(uint256 landId, uint256 index, bool upheld) external onlyRegistrar nonReentrant { LandRecord storage l = lands[landId]; require(l.registrar != msg.sender, "conflict registrar"); require(index < disputesByLand[landId].length, "invalid dispute"); Dispute storage d = disputesByLand[landId][index]; require(d.status == DisputeStatus.Open, "already resolved"); d.status = upheld ? DisputeStatus.Upheld : DisputeStatus.Rejected; l.openDisputes--; if (upheld) { usdt.safeTransfer(d.claimant, d.bond); l.status = LandStatus.Frozen; emit LandFrozen(landId); } else { usdt.safeTransfer(treasury, d.bond); if (l.openDisputes == 0) l.status = LandStatus.Registered; } emit DisputeResolved(landId, d.id, upheld); }
    function unfreeze(uint256 landId) external onlyRegistrar { LandRecord storage l = lands[landId]; require(l.id != 0 && l.openDisputes == 0 && l.status == LandStatus.Frozen, "cannot unfreeze"); l.status = LandStatus.Registered; emit LandUnfrozen(landId); }
    function requestTransfer(uint256 landId, address to, bytes32 newDocHash) external { LandRecord storage l = lands[landId]; require(l.owner == msg.sender && l.status == LandStatus.Registered && to != address(0), "transfer unavailable"); pendingTransfer[landId] = TransferRequest(to, newDocHash, true); emit TransferRequested(landId, to); }
    function approveTransfer(uint256 landId) external onlyRegistrar { LandRecord storage l = lands[landId]; TransferRequest memory request = pendingTransfer[landId]; require(l.status == LandStatus.Registered && request.pending, "transfer unavailable"); require(l.registrar == msg.sender, "record registrar only"); if (request.newDocHash != bytes32(0)) { require(landByDocHash[request.newDocHash] == 0, "duplicate document"); landByDocHash[l.docHash] = 0; landByDocHash[request.newDocHash] = landId; l.docHash = request.newDocHash; } address from = l.owner; l.owner = request.to; historyOf[landId].push(Transfer(from, request.to, uint64(block.timestamp), request.newDocHash)); delete pendingTransfer[landId]; emit TransferApproved(landId, from, request.to); }
    function cancelTransfer(uint256 landId) external { require(lands[landId].owner == msg.sender, "not owner"); delete pendingTransfer[landId]; }
    function getLand(uint256 id) external view returns (LandRecord memory) { return lands[id]; }
    function getDisputes(uint256 id) external view returns (Dispute[] memory) { return disputesByLand[id]; }
    function getHistory(uint256 id) external view returns (Transfer[] memory) { return historyOf[id]; }
}
